# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# Database (docker-compose's "db" service)
SS_DATABASE_CLASS="MySQLDatabase"
SS_DATABASE_SERVER="db"
SS_DATABASE_PORT="3306"
SS_DATABASE_NAME="silverstripe"
SS_DATABASE_USERNAME="root"
SS_DATABASE_PASSWORD="rootpassword"

# CMS admin created on first db:build
SS_DEFAULT_ADMIN_USERNAME="admin"
SS_DEFAULT_ADMIN_PASSWORD=""

SS_ENVIRONMENT_TYPE="dev"

# Site timezone (default America/Chicago, see app/_config.php)
# SS_TIMEZONE="America/Chicago"

# Dev mail: deliver to Mailpit (web UI at http://localhost:8025)
MAILER_DSN="smtp://mailpit:1025"

# Local module development: symlink vendor/antlion/* to these checkouts after
# composer install/update (bin/link-local-modules.sh). Omit to use GitHub copies.
# ANTLION_MODULES_DIR="/home/you/projects/antlion-modules"

# Optional: GitHub token for Composer (avoids API rate limits), read-only
# COMPOSER_AUTH={"github-oauth":{"github.com":"..."}}

# reCAPTCHA v3 (nswdpc/silverstripe-recaptcha-v3, app/_config/spamprotection.yml)
# RECAPTCHA_SITE_KEY=""
# RECAPTCHA_SECRET_KEY=""

# SEO AI meta descriptions (plasticstudio/silverstripe-seo-ai)
# OPENAI_API_KEY=""
